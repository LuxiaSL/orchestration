# Copy to deploy/local.env (gitignored) and fill in.
HOST=root@your-vps.example.com      # ssh target with root (installs a systemd unit + caddy include)
DOMAIN=orchestra.example.com        # DNS A record pointing at HOST; caddy gets the cert
OPERATOR=ada                        # your handle on the bus; sessions address you as @ada
VAPID_SUB=mailto:you@example.com    # contact claim sent to browser push services
# A second bus on the same box (someone else's, or a test one): copy this to its own file, set these too, and run
# ./deploy/deploy.sh deploy/<that file>. Its DOMAIN needs its own DNS record.
# NAME=orchestra-ada                # instance name: system user, unit, /opt/NAME, /var/lib/NAME (default orchestra)
# PORT=7461                         # localhost port behind caddy, one per bus (default 7460)
